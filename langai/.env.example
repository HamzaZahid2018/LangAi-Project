# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True

# Email Configuration (Gmail SMTP) - OPTIONAL
# Only needed if you want to send emails
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Email Sender - OPTIONAL
DEFAULT_FROM_EMAIL=LangAI <your-email@gmail.com>

# Groq API (for Speech-to-Text) - OPTIONAL
GROQ_API_KEY=your-groq-api-key-here

# Optional: Google Translate API Key (if using online translation)
GOOGLE_TRANSLATE_API_KEY=your-google-api-key-here

# NOTE: All email and API features are optional.
# Authentication now uses simple username/password login (no OTP required).
